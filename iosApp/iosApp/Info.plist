<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>AlarmBuddy</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleDisplayName</key>
    <string>AlarmBuddy</string>
    <key>UILaunchScreen</key>
    <dict/>

    <!-- Compose Multiplatform's iOS runtime does a startup "plist sanity
         check" and deliberately crashes (PlistSanityCheck) if this key is
         missing or false -- it's required for ProMotion/120Hz displays to
         animate smoothly instead of being capped at 60Hz. -->
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>

    <!-- Barcode scanning (AVCaptureDevice access) -->
    <key>NSCameraUsageDescription</key>
    <string>AlarmBuddy uses the camera to scan a barcode you set as a way to stop your alarm.</string>

    <!-- Shown once when AlarmKit first requests permission to schedule
         alarms (see AlarmKitBridge.swift). -->
    <key>NSAlarmKitUsageDescription</key>
    <string>AlarmBuddy uses AlarmKit to ring your alarms through Silent Mode and Focus, even if the app isn't running.</string>

    <!-- Lets an alarm that's already ringing (AlarmSoundPlayer.ios.kt, in the
         Ringing screen's task gate) keep playing its sound if the app is
         briefly backgrounded, e.g. while the barcode scanner briefly loses
         focus. Actually waking/ringing the alarm itself no longer depends on
         this -- that's AlarmKit's job now (see AlarmKitBridge.swift). -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>

    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
</dict>
</plist>
